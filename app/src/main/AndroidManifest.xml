<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 服务端自定义的绑定权限：必须声明，否则绑定被拒绝。
         注意安装顺序：先安装服务端（权限定义方）再安装客户端。 -->
    <uses-permission android:name="com.tasklinker.permission.BIND_TASK_SCHEDULER" />

    <!-- Android 11+ 包可见性：声明需要交互的服务端包 -->
    <queries>
        <package android:name="com.tasklinker.server" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskLinker">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
